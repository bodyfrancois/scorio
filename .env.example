# Clés API publiques RevenueCat (pas des secrets, safe à exposer côté client).
# Copie ce fichier en .env pour le dev local (déjà gitignoré).
# Pour la prod EAS Build : eas env:create --scope project --name EXPO_PUBLIC_REVENUECAT_IOS_KEY --value "..." --visibility plaintext
# (idem pour EXPO_PUBLIC_REVENUECAT_ANDROID_KEY), ou via le dashboard expo.dev > ton projet > Environment variables.

EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
